# Maintainer: trinity13338 <https://github.com/trinity13338>
pkgname=wraith-vpn
pkgver=0.13.2
pkgrel=1
_xrayver=26.11.9
pkgdesc="Xray VPN client (VLESS, VMess, Trojan, Shadowsocks, Hysteria2, WireGuard) with TUN and system proxy"
arch=('x86_64' 'aarch64')
url="https://github.com/trinity13338/Wraith-linux"
license=('GPL-3.0-or-later' 'MPL-2.0')
depends=('gcc-libs' 'glibc' 'dbus' 'libcap' 'polkit' 'libxkbcommon' 'wayland' 'libglvnd' 'hicolor-icon-theme')
makedepends=('cargo')
optdepends=('libx11: X11 sessions' 'libxcursor: X11 sessions' 'libxrandr: X11 sessions' 'libxi: X11 sessions'
            'kconfig: system proxy on KDE Plasma' 'gsettings-desktop-schemas: system proxy on GNOME'
            'xdg-utils: opening links and folders')
provides=('wraith')
conflicts=('wraith-vpn-bin')
install=wraith-vpn.install
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/linux-v$pkgver.tar.gz")
source_x86_64=("Xray-linux-64-$_xrayver.zip::https://github.com/XTLS/Xray-core/releases/download/v$_xrayver/Xray-linux-64.zip")
source_aarch64=("Xray-linux-arm64-v8a-$_xrayver.zip::https://github.com/XTLS/Xray-core/releases/download/v$_xrayver/Xray-linux-arm64-v8a.zip")
sha256sums=('8df9dff53e1102dac5e335de470138885af89bb895ac06ee674b9b8103b6dae6')
sha256sums_x86_64=('b651f7e1d9966ee2c1b1ee1bf8b52c72771824d3065dce96bbc8bcc19ed95f82')
sha256sums_aarch64=('64ed6858982a7f5eb85d88b811089063bd4f17561f4c8f44e0f1dc8e6f6430be')

_srcdir() { echo "$srcdir/Wraith-linux-linux-v$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$(_srcdir)"
  install -Dm755 target/release/wraith "$pkgdir/opt/wraith/wraith"
  install -Dm755 "$srcdir/xray" "$pkgdir/opt/wraith/xray"
  install -Dm644 "$srcdir/geoip.dat" "$pkgdir/opt/wraith/geoip.dat"
  install -Dm644 "$srcdir/geosite.dat" "$pkgdir/opt/wraith/geosite.dat"
  # pacman owns these files: Wraith leaves updates and removal to it.
  touch "$pkgdir/opt/wraith/wraith.packaged"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/wraith/wraith "$pkgdir/usr/bin/wraith"
  install -Dm644 packaging/wraith.desktop "$pkgdir/usr/share/applications/wraith.desktop"
  install -Dm644 packaging/wraith.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/wraith.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Xray"
}
